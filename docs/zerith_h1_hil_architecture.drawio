        </mxCell>
        <mxCell id="e-env-data" edge="1" parent="1" source="env" target="data-config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2F6FB0;fontColor=#2F6FB0;fontSize=11;labelBackgroundColor=#FFFFFF;labelPosition=center;verticalLabelPosition=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="obs + prompt">
