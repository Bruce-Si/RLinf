        <mxCell id="e-human-env" edge="1" parent="1" source="human" target="env" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=4 4;strokeWidth=1.5;strokeColor=#7A879B;fontColor=#5B667A;fontSize=10;labelBackgroundColor=#FFFFFF;labelPosition=right;verticalLabelPosition=middle;" value="intervention">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RLinf nodes. -->
        <mxCell id="human" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA6B8;dashed=1;dashPattern=5 4;fontColor=#202938;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;Teleop / 人工干预&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B667A&quot;&gt;接管 · 纠正 · intervene flag&lt;/font&gt;" vertex="1">
