<mxfile host="Electron" agent="Codex">
  <diagram id="zerith-h1-hil-v2" name="Zerith H1 Pro HIL RL">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#202938;fontFamily=Arial;spacingLeft=0;" value="&lt;font style=&quot;font-size:26px&quot;&gt;Zerith H1 Pro 真机人在环强化学习架构&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5B667A&quot;&gt;RLinf 负责 env / rollout / reward / replay / learner；ZERITH/OpenPI Policy Adapter 负责 DataConfig / transforms / π0 / action chunk / RTC&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="1450" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5B667A;fontFamily=Arial;fontSize=12;spacingLeft=0;" value="图例：蓝色实线 = 实时控制路径；橙色虚线 = HIL episode / replay / policy update 回流；灰色虚线 = 人工干预。" vertex="1">
          <mxGeometry height="22" width="1450" x="50" y="78" as="geometry" />
        </mxCell>

        <mxCell id="zone-rlinf" parent="1" style="swimlane;html=1;rounded=1;horizontal=1;startSize=36;fillColor=#F7F8FA;strokeColor=#AAB3C2;fontColor=#202938;fontStyle=1;fontSize=16;align=left;spacingLeft=14;verticalAlign=middle;" value="RLinf：训练与采样编排" vertex="1">
          <mxGeometry height="590" width="400" x="50" y="125" as="geometry" />
        </mxCell>
        <mxCell id="zone-zerith" parent="1" style="swimlane;html=1;rounded=1;horizontal=1;startSize=36;fillColor=#FCFBF8;strokeColor=#AAB3C2;fontColor=#202938;fontStyle=1;fontSize=16;align=left;spacingLeft=14;verticalAlign=middle;" value="ZERITH / OpenPI Policy Adapter：π0 真机适配" vertex="1">
          <mxGeometry height="590" width="500" x="500" y="125" as="geometry" />
        </mxCell>
        <mxCell id="zone-h1" parent="1" style="swimlane;html=1;rounded=1;horizontal=1;startSize=36;fillColor=#F7F8FA;strokeColor=#AAB3C2;fontColor=#202938;fontStyle=1;fontSize=16;align=left;spacingLeft=14;verticalAlign=middle;" value="H1 Pro：真机与设备服务" vertex="1">
          <mxGeometry height="590" width="480" x="1060" y="125" as="geometry" />
