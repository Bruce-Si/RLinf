        <!-- Real-time path (blue solid). Edges are declared before nodes so they render behind boxes. -->
        <mxCell id="e-camera-env" edge="1" parent="1" source="camera" target="env" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2F6FB0;fontColor=#2F6FB0;fontSize=11;labelBackgroundColor=#FFFFFF;labelPosition=center;verticalLabelPosition=bottom;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="observation：3 cameras + 23D state">
