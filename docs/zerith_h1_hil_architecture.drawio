        <mxCell id="e-pi0-rtc" edge="1" parent="1" source="pi0" target="rtc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2F6FB0;fontColor=#2F6FB0;fontSize=11;labelBackgroundColor=#FFFFFF;labelPosition=right;verticalLabelPosition=middle;" value="50-step chunk · execute 10">
