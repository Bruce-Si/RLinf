        <mxCell id="flow-caption" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5B667A;fontFamily=Arial;fontSize=12;spacingLeft=0;" value="实时控制：Camera/State → ZerithRealEnv → DataConfig → π0 → RTC → H1 SDK → H1 Pro　　异步回流：H1 Pro → ZerithRealEnv → Archive → Learner → π0 Policy" vertex="1">
