        <mxCell id="ownership-caption" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5B667A;fontFamily=Arial;fontSize=12;spacingLeft=0;" value="职责边界：DataConfig / transforms / normalization / π0 / action chunk / RTC 属于 Zerith/OpenPI Policy Adapter；RLinf 通过 ZerithRealEnv 提供 obs、reward、intervention、replay 和 learner。" vertex="1">
